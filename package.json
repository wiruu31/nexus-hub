{
  "name": "nexus-hub",
  "version": "1.0.0",
  "description": "Backend API pribadi modular: satu hub, satu API key per project, banyak modul.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "token": "node -e \"import('node:crypto').then(c=>console.log(c.randomBytes(24).toString('base64url')))\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "fastify": "^5.0.0"
  }
}
