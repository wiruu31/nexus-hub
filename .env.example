# Salin file ini jadi .env, lalu isi nilainya. Jangan commit .env.

# Wajib. Minimal 16 karakter. Dipakai untuk masuk ke dashboard.
# Buat nilai acak dengan: npm run token
ADMIN_TOKEN=

# Alamat dan port server.
HOST=0.0.0.0
PORT=3000

# Lokasi file database. Kosongkan untuk memakai data/nexus.db di folder project.
DB_PATH=

# Batas request per menit untuk key baru kalau tidak diisi saat dibuat.
DEFAULT_RATE_LIMIT=60

# Log yang lebih tua dari ini dihapus otomatis.
LOG_KEEP_DAYS=30

# Isi true kalau Nexus ada di belakang reverse proxy (Nginx, Caddy, Cloudflare)
# supaya alamat IP pemanggil terbaca benar.
TRUST_PROXY=false

# Daftar asal web yang boleh memanggil /v1 dari browser, pisahkan dengan koma.
# Contoh: https://blog.contoh.com,https://app.contoh.com
# Kosong berarti tidak ada web yang boleh. Bot dan server tidak terpengaruh.
CORS_ORIGINS=

# Modul Notifier. Token dari @BotFather, chat id dari bot yang kamu ajak bicara.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
